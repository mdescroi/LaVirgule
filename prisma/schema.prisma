// Prisma Schema — Restaurant La Virgule (Niort / Chauray)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum DishCategory {
  STARTER
  MAIN
  DESSERT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ServiceSlot {
  LUNCH
  DINNER
  OTHER
}

/// Préférence d'espace exprimée par le client (la salle exacte reste attribuée par l'équipe)
enum SpacePreference {
  INDOOR
  OUTDOOR
  ANY
}

// ─────────────────────────── MODELS ──────────────────────────

/// Utilisateur administrateur (back-office)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Sous-catégorie de plat (dynamique, gérable depuis l'admin)
model DishSubCategory {
  id             String       @id @default(cuid())
  name           String
  parentCategory DishCategory
  sortOrder      Int          @default(0)
  dishes         Dish[]
  createdAt      DateTime     @default(now())

  @@map("dish_sub_categories")
}

/// Plat de la carte
model Dish {
  id            String           @id @default(cuid())
  name          String
  description   String
  price         Decimal          @db.Decimal(8, 2)
  category      DishCategory
  subCategoryId String?
  subCategory   DishSubCategory? @relation(fields: [subCategoryId], references: [id])
  sortOrder     Int              @default(0)
  isAvailable   Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category, isAvailable])
  @@map("dishes")
}

/// Menu du jour
model MenuOfTheDay {
  id             String   @id @default(cuid())
  date           DateTime @unique @db.Date
  starterName      String
  mainCourseName   String
  dessertName      String
  priceStarterMain Decimal  @db.Decimal(8, 2)
  priceFullMenu    Decimal  @db.Decimal(8, 2)
  priceMainDessert Decimal  @db.Decimal(8, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("menus_of_the_day")
}

/// Paramètres du site (singleton id="singleton")
model SiteSettings {
  id         String   @id @default("singleton")
  hoursLine1 String   @default("Service du midi de 12h à 14h.")
  hoursLine2 String   @default("Service du soir de 19h à 21h")
  hoursLine3 String   @default("Du Lundi au Vendredi")
  updatedAt  DateTime @updatedAt

  @@map("site_settings")
}

/// Espace du restaurant (3 salles intérieures + terrasse)
model Space {
  id           String        @id @default(cuid())
  name         String        @unique
  capacity     Int
  isOutdoor    Boolean       @default(false)
  description  String?
  imageUrl     String?
  sortOrder    Int           @default(0)
  reservations Reservation[]

  @@map("spaces")
}

/// Réservation client (< 12 pers. = CONFIRMED, >= 12 pers. = PENDING / devis groupe)
model Reservation {
  id           String            @id @default(cuid())
  customerName String
  firstName    String
  email        String
  phone        String
  date         DateTime
  slot         ServiceSlot       @default(LUNCH)
  guestCount   Int
  status       ReservationStatus @default(PENDING)
  isGroup      Boolean           @default(false)
  message      String?
  spacePreference SpacePreference? // Souhait client (Intérieur / Extérieur / Indifférent)
  spaceId      String?
  space        Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([date, status])
  @@index([spaceId])
  @@map("reservations")
}

/// Événement / soirée spéciale affiché sur la page Événements
model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  endDate     DateTime?
  location    String?
  imageUrl    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("events")
}

/// Planning d'ouverture hebdomadaire par défaut (grille récurrente midi/soir par jour de semaine)
/// dayOfWeek suit la convention JS Date#getUTCDay() : 0 = dimanche ... 6 = samedi
model WeeklyOpeningHours {
  id         String   @id @default(cuid())
  dayOfWeek  Int      @unique
  lunchOpen  Boolean  @default(true)
  dinnerOpen Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@map("weekly_opening_hours")
}

/// Message envoyé via le formulaire de contact
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
